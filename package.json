{
  "name": "napams-monitor",
  "version": "1.0.0",
  "description": "Offline validation and live monitoring automation for NAFDAC NAPAMS application status checks.",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/cryptoaux/Napams-Monitor.git"
  },
  "bugs": {
    "url": "https://github.com/cryptoaux/Napams-Monitor/issues"
  },
  "homepage": "https://github.com/cryptoaux/Napams-Monitor",
  "scripts": {
    "monitor": "node monitor.js",
    "build": "npm run check:syntax && npm run typecheck",
    "test": "node --test ./test/*.test.js",
    "test:coverage": "c8 --all --include \"src/**/*.js\" --include \"monitor.js\" --check-coverage --statements 80 --branches 75 --functions 80 --lines 80 npm run test",
    "test:unit": "node --test ./test/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "check:syntax": "node --check monitor.js && node --check src/*.js"
  },
  "dependencies": {
    "@sentry/node": "^10.73.0",
    "pino": "^10.3.1",
    "playwright": "^1.55.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "c8": "^12.0.0",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
