# Example configuration only. Replace these placeholders locally.
# Supply real credentials through a secure secret mechanism; never commit them.

LOG_LEVEL=info
MONITOR_COMPANIES_FILE=companies.json
MONITOR_OUTPUT_PATH=public/data.json
NODE_ENV=production

# Optional structured error tracking for production robustness.
# Error tracking is DISABLED by default and is safe to leave unset.
# To enable error tracking, set ERROR_TRACKING_ENABLED=true and provide a valid DSN.
# Never commit a real DSN; use GitHub Actions secrets or environment configuration instead.
ERROR_TRACKING_ENABLED=false
ERROR_TRACKING_DSN=https://example.invalid/error-tracking-dsn

# Company credentials are supplied as individual environment variables matching
# the names referenced by companies.json in the form COMPANY_N_TIN / COMPANY_N_PASSWORD.
# These values should be provided by the local shell or by GitHub repository secrets.
#
# Example for the first two configured companies:
# COMPANY_1_TIN=example-company-1-tin
# COMPANY_1_PASSWORD=example-company-1-password
# COMPANY_2_TIN=example-company-2-tin
# COMPANY_2_PASSWORD=example-company-2-password
#
# Keep these values out of source control and never commit real credentials.

COMPANY_1_TIN=example-company-1-tin
COMPANY_1_PASSWORD=example-company-1-password
